class Solution {
public:
    int removeElement(vector<int>& nums, int val) {
        int i = 0;
        int j=nums.size()-1;
        int count=0;
        while(i<=j){
            if(nums[i]==val){
                if(nums[j]==val){
                    j--;
                    continue;
                }
                else{
                    swap(nums[i],nums[j]);
                    j--;
                }    
            }
            i++;    
        }
        return i;
       
    }
};
